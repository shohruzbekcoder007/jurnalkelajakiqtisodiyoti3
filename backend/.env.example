PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/moliyaviy_texnologiyalar

# Frontend alohida domenda bo'lsa, uning manzili (vergul bilan bir nechta).
# Frontend shu serverdan berilsa (production), bu qatorni bo'sh qoldiring.
CLIENT_URL=http://localhost:5173

# JWT kaliti — production'da uzun tasodifiy qiymat qo'ying
JWT_SECRET=bu-yerga-uzun-tasodifiy-kalit-yozing
JWT_EXPIRES_IN=7d

# Birinchi admin (npm run seed yoki npm run create-admin)
ADMIN_EMAIL=admin@tdiu.uz
ADMIN_PASSWORD=kamida-8-belgili-parol

# Ixtiyoriy: yuklangan PDF'lar va tayyor frontend papkasi
# UPLOAD_DIR=/var/www/jurnal/uploads
# CLIENT_DIR=/var/www/jurnal/frontend/dist
